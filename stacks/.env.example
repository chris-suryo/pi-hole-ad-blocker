# Shared settings for stacks/*/compose.yaml. Each machine keeps its own copy:
#   cp stacks/.env.example stacks/.env      (git-ignored)

# Your timezone, e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TZ=America/New_York

# Your user and group IDs on this machine. Check with: id -u ; id -g
PUID=1000
PGID=1000

# Per-app config and databases. On the media PC this is on the boot SSD.
APPDATA=/srv/appdata

# --- Media PC only ---------------------------------------------------------
# Movies/TV/music. Lives inside the "data" dataset together with the downloads from
# chris-suryo/plex-server, so Sonarr/Radarr can hardlink instead of copying.
MEDIA_DIR=/srv/storage/data/media
# Group that owns /dev/dri (Quick Sync). Check with: getent group render | cut -d: -f3
RENDER_GID=
