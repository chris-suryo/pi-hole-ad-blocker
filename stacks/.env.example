# Shared settings for stacks/*/compose.yaml. Copy to stacks/.env (git-ignored) and edit.
#   cp stacks/.env.example stacks/.env

# Your timezone, e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TZ=America/New_York

# Your user and group IDs on the Pi. Check with: id -u ; id -g
PUID=1000
PGID=1000

# Per-app config and databases. Keep it off the SD card later if you add an SSD.
APPDATA=/srv/appdata

# Movies/TV/music, once a storage drive is mounted (docs/07-storage-media-photos.md).
MEDIA_DIR=/srv/storage/media
